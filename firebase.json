{
  "hosting": [
    {
      "target": "live",
      "public": "firebase-live-redirect/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, max-age=0, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
